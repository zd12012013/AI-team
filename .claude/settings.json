{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session_start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/setup.sh)",
      "Bash(bash scripts/prep.sh:*)",
      "Bash(bash scripts/zoom.sh:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)",
      "Bash(montage:*)",
      "Bash(ls:*)"
    ]
  }
}
